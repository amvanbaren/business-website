---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { Separator } from "@/components/starwind/separator";

interface Props extends HTMLAttributes<"article"> {
  /** Service page title */
  title: string;
  /** Service description / subtitle */
  description: string;
}

const sectionStyles = tv({
  base: "@container mx-auto w-full max-w-3xl px-4 py-24",
});

const { title, description, class: className, ...rest } = Astro.props;
---

<article class={sectionStyles({ class: className })} {...rest}>
  <!-- Title — oversized for typographic impact -->
  <h1
    class="font-heading text-4xl font-bold tracking-tight @xl:text-5xl @3xl:text-6xl"
  >
    {title}
  </h1>

  <!-- Description as lead paragraph -->
  <p
    class="text-muted-foreground mt-6 text-xl leading-relaxed text-pretty @xl:text-2xl"
  >
    {description}
  </p>

  <Separator class="my-10" />

  <!-- Content slot -->
  <slot />
</article>
