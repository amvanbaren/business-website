---
import Moon from "@tabler/icons/filled/moon.svg";
import Sun from "@tabler/icons/filled/sun.svg";
import IconBrandGithub from "@tabler/icons/filled/brand-github.svg";
import IconBrandLinkedin from "@tabler/icons/filled/brand-linkedin.svg";
import IconBrandYoutube from "@tabler/icons/filled/brand-youtube.svg";
import IconBrandX from "@tabler/icons/outline/brand-x.svg";
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";
import ThemeToggle from "./starwind/theme-toggle";

export interface SocialLink {
  name: string;
  href: string;
  icon: any;
}

interface Props extends HTMLAttributes<"footer"> {
  /** Array of social media links */
  socialLinks?: SocialLink[];
  /** Company name for copyright */
  companyName?: string;
}

const footerStyles = tv({
  base: "@container w-full border-t py-12",
});

const {
  socialLinks = [
    { name: "Twitter", href: "https://twitter.com", icon: IconBrandX },
    { name: "GitHub", href: "https://github.com", icon: IconBrandGithub },
    { name: "LinkedIn", href: "https://linkedin.com", icon: IconBrandLinkedin },
    { name: "YouTube", href: "https://youtube.com", icon: IconBrandYoutube },
  ],
  companyName = "Your Company",
  class: className,
  ...rest
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class={footerStyles({ class: className })} {...rest}>
  <div class="mx-auto w-full max-w-7xl px-4">
    <div
      class="flex justify-center sm:justify-between gap-4 sm:gap-0 items-center"
    >
      <!-- must match ThemeToggle width (size-5 + (gap-2 * 2)) -->
      <div class="hidden sm:block sm:min-w-9"></div>
      <div class="flex items-center gap-4 sm:gap-6">
        <!-- Copyright -->
        <p class="text-left sm:text-center text-muted-foreground text-sm">
          © {currentYear}
          {companyName}.<br class="sm:hidden" /><span class="hidden sm:inline"
            >&nbsp;</span
          >All rights reserved.
        </p>
        <!-- Social Links -->
        {
          socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-foreground transition-colors"
              aria-label={social.name}
            >
              <social.icon class="size-5.5" aria-hidden="true" />
            </a>
          ))
        }
      </div>
      <ThemeToggle
        variant="default"
        size="sm"
        class="text-muted-foreground hover:text-foreground"
      >
        <Sun
          slot="light-icon"
          class="hidden size-5 group-data-[state=off]:data-ready:block"
          data-theme-icon
        />
        <Moon
          slot="dark-icon"
          class="hidden size-5 group-data-[state=on]:data-ready:block"
          data-theme-icon
        />
      </ThemeToggle>
    </div>
  </div>
</footer>
